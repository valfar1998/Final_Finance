# Copia come .env e inserisci le chiavi UNA SOLA VOLTA.
# L'API principale viene scelta automaticamente (vedi sotto).

# Finnhub (gratis): https://finnhub.io/register — internazionale + universo titoli
FINNHUB_API_KEY=

# Twelve Data (gratis 800 req/giorno): https://twelvedata.com/register — prezzi USA (primaria auto)
TWELVE_DATA_API_KEY=

# FMP (gratis 250 req/giorno): https://site.financialmodelingprep.com — analisti USA (primaria auto)
FMP_API_KEY=

# Override opzionale (default: auto). Esempi:
# PRIMARY_PRICE_API=twelve_data,fmp,finnhub,yahoo_chart
# PRIMARY_ANALYST_API=fmp,yahoo,finnhub

# Alpha Vantage (gratis 25 req/giorno — molto limitato)
# ALPHA_VANTAGE_API_KEY=

# Alert Telegram portafoglio (variazione buyability %)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FA_SCORE_ALERT_MIN_DELTA=5
