# Copia in .env (non committare). In locale il progetto legge anche i .env
# dei progetti accanto (Finance-Analyzer, football-predictor, recensioni).

# Telegram — stesso bot di calcio/recensioni
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Consigliato (gratis, 60 req/min): https://finnhub.io/register
# FINNHUB_API_KEY=

# Opzionale USA (250 req/giorno): https://site.financialmodelingprep.com/developer/docs
# FMP_API_KEY=

# Opzionale prezzi (800 req/giorno): https://twelvedata.com/register
# TWELVE_DATA_API_KEY=

# Opzionale, più “pro”: https://polygon.io/dashboard/signup
# POLYGON_API_KEY=

# News aggregata (100 req/giorno free): https://newsapi.org/register
# NEWSAPI_API_KEY=

# News finanziarie con ticker taggati: https://www.marketaux.com/register
# MARKETAUX_API_TOKEN=

# Wire Benzinga (più “real time”): https://www.benzinga.com/apis/
# BENZINGA_API_TOKEN=

# LLM per filtrare news (opzionale, consigliato): Groq gratis o Gemini Flash
# GROQ_API_KEY=           # https://console.groq.com/
# GEMINI_API_KEY=         # https://aistudio.google.com/apikey
# NEWS_LLM_PROVIDER=groq  # groq | gemini | off

# SEC EDGAR (gratis, nessuna API key). Serve un contatto nel User-Agent.
# SEC_CONTACT_EMAIL=tuamail@esempio.com

# Upstash Redis — dedupe alert condivisa tra run GitHub Actions (consigliato)
# 1. https://console.upstash.com → Create database → REST API
# 2. Copia UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN in .env e GitHub Secrets
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Quant Platform: regolatori internazionali ──
# UK FCA Register API (gratis, registrati su register.fca.org.uk/Developer)
# FCA_AUTH_EMAIL=tua@email.com
# FCA_API_KEY=

# Japan FSA / EDINET (gratis, registrati su disclosure2.edinet-fsa.go.jp)
# FSA_EDINET_API_KEY=

# Korea FSS OpenDART (gratis, registrati su opendart.fss.or.kr) — in attesa approvazione ok
# OPEN_DART_API_KEY=

# EODHD — quote multi-mercato CN/HK/KR/US (https://eodhd.com)
# EODHD_API_TOKEN=

# Cina / Corea — librerie locali opzionali (non servono in GitHub Actions):
#   pip install -r requirements-asia.txt
#   AKShare (gratis), TuShare (TUSHARE_TOKEN da tushare.pro), FinanceDataReader, PyKRX
# TUSHARE_TOKEN=

# AMF (Francia), ESMA, BaFin, CONSOB → nessuna chiave (open data / scraping)
# Score unificato (override config/unified.yaml)
# UNIFIED_MIN_SCORE=5
# UNIFIED_MIN_FUNDAMENTAL=40

# Soglie (override di config/watchlist.yaml)
# SPIKE_PCT=3
# SURPRISE_EPS_PCT=5
