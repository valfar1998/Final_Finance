# Copia questo file come ".env" e inserisci UNA chiave API.

# --- OpenAI (consigliato) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google Gemini ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- API compatibile OpenAI (opzionale) ---
# OPENAI_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=gpt-4o

# Porta del sito locale
PORT=5055

# Alert Telegram su variazione score (stesso bot di finance-alert)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SCORE_ALERT_MIN_DELTA=3
